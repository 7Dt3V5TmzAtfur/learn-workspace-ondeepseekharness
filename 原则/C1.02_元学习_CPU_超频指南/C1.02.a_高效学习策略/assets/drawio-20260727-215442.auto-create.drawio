        <mxCell id="XNTG3MUbBzei63mt0RzP-38" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A148C;fontStyle=1;" value="第一性原理：打造超越单点时间和个人体力的“可复制繁殖资产”，从线性劳动力转化为系统架构师。" vertex="1">
          <mxGeometry height="25" width="900" x="210" y="145" as="geometry" />
        </mxCell>
