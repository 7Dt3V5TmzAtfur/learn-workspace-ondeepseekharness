        <mxCell id="XNTG3MUbBzei63mt0RzP-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px;color:#1976D2&quot;&gt;2. 设定未来对标轴&lt;/b&gt;&lt;hr style=&quot;border-color:#DDDDDD;margin:5px 0&quot;&gt;停止与他人的现状比较&lt;br&gt;写下自己5年后的量化目标" vertex="1">
          <mxGeometry height="80" width="180" x="430" y="915" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-10" edge="1" parent="1" source="XNTG3MUbBzei63mt0RzP-9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" target="XNTG3MUbBzei63mt0RzP-11">
          <mxGeometry relative="1" as="geometry" />
