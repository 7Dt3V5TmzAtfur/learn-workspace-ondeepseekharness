        <mxCell id="XNTG3MUbBzei63mt0RzP-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#117A65;strokeWidth=2;fontColor=#004D40;align=center;" value="&lt;b style=&quot;font-size:26px&quot;&gt;《新生：七年就是一辈子》行动与反馈实战全景图&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;核心要义：抛弃空想与解释，建立【行动试错 ➔ 残酷复盘 ➔ 迭代算法 ➔ 跨界杠杆】的物理闭环&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1360" x="10" y="20" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;fontColor=#333333;" value="&lt;b&gt;#实战指南 #行动闭环&lt;br&gt;#PDCA迭代&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="140" x="20" y="30" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#999999;strokeWidth=1.5;" vertex="1">
          <mxGeometry height="200" width="960" x="180" y="860" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1.5;fontColor=#333333;align=center;" value="&lt;b style=&quot;font-size:16px&quot;&gt;初始设定&lt;br&gt;(Plan)&lt;br&gt;&lt;br&gt;清理系统&lt;/b&gt;" vertex="1">
          <mxGeometry height="200" width="100" x="60" y="860" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-5" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;fontStyle=1;" value="第一性原理：所有不以“自身实质性进步”为目的的想法，全都是毒概念，必须被隔离。" vertex="1">
          <mxGeometry height="25" width="900" x="210" y="865" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-6" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;fontStyle=1;fillColor=#E0E0E0;" value="底层动作：在脑海中完成“最差情况预演”，并给自己的系统预留足够的容错率和冗余度。" vertex="1">
          <mxGeometry height="30" width="920" x="200" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px;color:#D32F2F&quot;&gt;1. 识别并剔除毒概念&lt;/b&gt;&lt;hr style=&quot;border-color:#DDDDDD;margin:5px 0&quot;&gt;列出“表现型/要面子”的念头&lt;br&gt;强行转化为“进取型/要成长”" vertex="1">
          <mxGeometry height="80" width="180" x="210" y="915" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-8" edge="1" parent="1" source="XNTG3MUbBzei63mt0RzP-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" target="XNTG3MUbBzei63mt0RzP-9">
          <mxGeometry relative="1" as="geometry" />
