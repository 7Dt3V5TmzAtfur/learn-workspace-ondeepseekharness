          <mxGeometry height="80" width="180" x="430" y="675" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-21" edge="1" parent="1" source="XNTG3MUbBzei63mt0RzP-20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4CAF50;strokeWidth=2;endArrow=block;" target="XNTG3MUbBzei63mt0RzP-22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#81C784;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px;color:#2E7D32&quot;&gt;3. 强制公开输出&lt;/b&gt;&lt;hr style=&quot;border-color:#DDDDDD;margin:5px 0&quot;&gt;用实名写作/做项目/售卖&lt;br&gt;拿作品去验证市场反应" vertex="1">
          <mxGeometry height="80" width="180" x="650" y="675" as="geometry" />
        </mxCell>
