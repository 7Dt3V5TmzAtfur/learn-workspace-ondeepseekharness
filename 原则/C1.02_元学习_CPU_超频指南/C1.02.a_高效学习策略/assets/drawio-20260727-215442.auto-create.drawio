        <mxCell id="XNTG3MUbBzei63mt0RzP-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#1B5E20;align=center;" value="&lt;b style=&quot;font-size:16px&quot;&gt;极速行动&lt;br&gt;(Do)&lt;br&gt;&lt;br&gt;碰撞现实&lt;/b&gt;" vertex="1">
          <mxGeometry height="200" width="100" x="60" y="620" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-16" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#1B5E20;fontStyle=1;" value="第一性原理：新领域没有地图，只有先乱撞（行动）才能获得坐标（反馈），想清楚是做不出来的。" vertex="1">
          <mxGeometry height="25" width="900" x="210" y="625" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-17" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#1B5E20;fontStyle=1;fillColor=#A5D6A7;" value="底层动作：关闭无效输入源，切断毫无意义的争论，强行以公开的作品/产品去经受市场和他人的毒打。" vertex="1">
          <mxGeometry height="30" width="920" x="200" y="780" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#81C784;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px;color:#2E7D32&quot;&gt;1. 开启“苍蝇模式”&lt;/b&gt;&lt;hr style=&quot;border-color:#DDDDDD;margin:5px 0&quot;&gt;在新领域无视嘲笑乱撞试错&lt;br&gt;快速多线程并发测试" vertex="1">
          <mxGeometry height="80" width="180" x="210" y="675" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-19" edge="1" parent="1" source="XNTG3MUbBzei63mt0RzP-18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4CAF50;strokeWidth=2;endArrow=block;" target="XNTG3MUbBzei63mt0RzP-20">
          <mxGeometry relative="1" as="geometry" />
