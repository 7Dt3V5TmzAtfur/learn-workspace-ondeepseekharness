        <mxCell id="XNTG3MUbBzei63mt0RzP-26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#0D47A1;align=center;" value="&lt;b style=&quot;font-size:16px&quot;&gt;残酷检验&lt;br&gt;(Check/Act)&lt;br&gt;&lt;br&gt;修正算法&lt;/b&gt;" vertex="1">
          <mxGeometry height="200" width="100" x="60" y="380" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-27" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0D47A1;fontStyle=1;" value="第一性原理：不要用嘴道歉，用行动道歉；人微易怒，只有承认“我错了且我很差”，才能重启进化。" vertex="1">
          <mxGeometry height="25" width="900" x="210" y="385" as="geometry" />
        </mxCell>
        <mxCell id="XNTG3MUbBzei63mt0RzP-28" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#0D47A1;fontStyle=1;fillColor=#90CAF9;" value="底层动作：把错误抽离出“自尊”，当做代码Bug来修；一旦找到门道，立刻切换聚光灯般的专注力。" vertex="1">
          <mxGeometry height="30" width="920" x="200" y="540" as="geometry" />
