        <mxCell id="UO7uAtX1WqEGF_7-64Dm-28" parent="1" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontColor=#1B5E20;fontStyle=1;" value="&lt;br&gt;&lt;b style=&quot;font-size:18px&quot;&gt;【个人OS进化总线】&lt;/b&gt;&lt;br&gt;&lt;br&gt;贯穿一生的安全绳与加速器&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px;color:#D32F2F&quot;&gt;财富 = 能力 × 周期&lt;sup&gt;执行&lt;/sup&gt;&lt;/b&gt;" vertex="1">
