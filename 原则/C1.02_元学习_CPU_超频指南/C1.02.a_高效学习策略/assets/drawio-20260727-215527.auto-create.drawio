        <mxCell id="UO7uAtX1WqEGF_7-64Dm-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#555555;" value="#行动清单 #容错反馈 #实战变现" vertex="1">
          <mxGeometry height="30" width="200" x="380" y="205" as="geometry" />
