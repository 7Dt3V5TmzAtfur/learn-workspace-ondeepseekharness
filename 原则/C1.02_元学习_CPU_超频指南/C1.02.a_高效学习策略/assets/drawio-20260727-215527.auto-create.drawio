        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#388E3C;strokeWidth=1.5;shadow=1;" value="&lt;b&gt;保持进取型人格&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#388E3C&quot;&gt;不为“别人眼光”要面子&lt;br&gt;只为“明天的自己更强”&lt;br&gt;接受当下的笨拙与弱小" vertex="1">
          <mxGeometry height="100" width="160" x="1550" y="440" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#388E3C;strokeWidth=1.5;shadow=1;" value="&lt;b&gt;做周期穿越者&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#388E3C&quot;&gt;永远不All-in赌博&lt;br&gt;保证现金流/活得足够久&lt;br&gt;在正确方向等待复利拐点" vertex="1">
          <mxGeometry height="100" width="160" x="1550" y="590" as="geometry" />
