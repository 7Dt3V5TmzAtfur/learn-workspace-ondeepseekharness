        <mxCell id="UO7uAtX1WqEGF_7-64Dm-27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#388E3C;strokeWidth=2;" vertex="1">
          <mxGeometry height="970" width="200" x="1530" y="270" as="geometry" />
