        <mxCell id="UO7uAtX1WqEGF_7-64Dm-31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#388E3C;strokeWidth=1.5;shadow=1;" value="&lt;b&gt;建立资本护城河&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color:#388E3C&quot;&gt;锻炼身体(硬件升级)&lt;br&gt;尽早强制储蓄与投资&lt;br&gt;远离消费借贷陷阱" vertex="1">
