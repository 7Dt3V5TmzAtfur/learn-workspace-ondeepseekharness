        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#555555;strokeWidth=1.5;fontColor=#E65100;align=center;" value="&lt;b style=&quot;font-size:16px&quot;&gt;里程碑&lt;br&gt;&lt;br&gt;涌&lt;br&gt;现&lt;br&gt;与&lt;br&gt;变&lt;br&gt;现&lt;/b&gt;" vertex="1">
