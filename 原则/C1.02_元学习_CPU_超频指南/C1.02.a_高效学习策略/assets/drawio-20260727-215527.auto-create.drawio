        <mxCell id="UO7uAtX1WqEGF_7-64Dm-39" parent="UO7uAtX1WqEGF_7-64Dm-38" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;构造“睡后收入”&lt;/b&gt;&lt;hr style=&quot;border-color:#555555;margin:5px 0&quot;&gt;&lt;b&gt;行动&lt;/b&gt;：写书、写代码、投资定投&lt;br&gt;&lt;b&gt;检验&lt;/b&gt;：哪怕睡觉时也有利息/版税入账&lt;br&gt;&lt;b&gt;避坑&lt;/b&gt;：绝不借钱消费，只为生产借贷" vertex="1">
