        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-6" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#E65100;fontStyle=1;" value="【终极检验目标】能力必须通过跨界变现与睡后收入来证实，所有不以“产出实际价值”为目的的努力都是自我欺骗。" vertex="1">
          <mxGeometry height="25" width="900" x="560" y="275" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-7" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#E65100;fontStyle=1;fillColor=#FFE0B2;" value="【实操检验标准】你的闲暇时间是否在产生利润？你是否买得起、并在用最好的生产力工具？" vertex="1">
          <mxGeometry height="30" width="920" x="550" y="450" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#555555;strokeWidth=1.5;" vertex="1">
          <mxGeometry height="220" width="960" x="530" y="520" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#555555;strokeWidth=1.5;fontColor=#1565C0;align=center;" value="&lt;b style=&quot;font-size:16px&quot;&gt;修正层&lt;br&gt;&lt;br&gt;重&lt;br&gt;构&lt;br&gt;与&lt;br&gt;打&lt;br&gt;丁&lt;/b&gt;" vertex="1">
          <mxGeometry height="220" width="100" x="410" y="520" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-10" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#1565C0;fontStyle=1;" value="【修正准则】犯错是必然的，关键是能否像程序员修Bug一样，无情绪地更改自己的底层概念和响应模式。" vertex="1">
          <mxGeometry height="25" width="900" x="560" y="525" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-11" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#1565C0;fontStyle=1;fillColor=#BBDEFB;" value="【实操检验标准】遇到新麻烦时，第一反应是发怒抱怨，还是立刻切换到“苍蝇模式”或开启“多任务处理”？" vertex="1">
          <mxGeometry height="30" width="920" x="550" y="700" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#555555;strokeWidth=1.5;" vertex="1">
          <mxGeometry height="220" width="960" x="530" y="770" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#555555;strokeWidth=1.5;fontColor=#4A148C;align=center;" value="&lt;b style=&quot;font-size:16px&quot;&gt;反馈层&lt;br&gt;&lt;br&gt;真&lt;br&gt;实&lt;br&gt;世&lt;br&gt;界&lt;br&gt;检&lt;br&gt;验&lt;/b&gt;" vertex="1">
          <mxGeometry height="220" width="100" x="410" y="770" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-14" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A148C;fontStyle=1;" value="【反馈准则】免费的赞美全是幻觉。你的能力和认知，必须在商业交易、人际冲突和投资风险中遭受真实毒打。" vertex="1">
          <mxGeometry height="25" width="900" x="560" y="775" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-15" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A148C;fontStyle=1;fillColor=#E1BEE7;" value="【实操检验标准】是否有人愿意花钱买你的东西？你是否定期复盘自己的蠢事？是否果断拉黑了消耗你的人？" vertex="1">
          <mxGeometry height="30" width="920" x="550" y="950" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#555555;strokeWidth=1.5;" vertex="1">
          <mxGeometry height="220" width="960" x="530" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#555555;strokeWidth=1.5;fontColor=#880E4F;align=center;" value="&lt;b style=&quot;font-size:16px&quot;&gt;动作层&lt;br&gt;&lt;br&gt;每&lt;br&gt;日&lt;br&gt;刚&lt;br&gt;性&lt;br&gt;执&lt;br&gt;行&lt;/b&gt;" vertex="1">
          <mxGeometry height="220" width="100" x="410" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-18" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#880E4F;fontStyle=1;" value="【执行准则】行动是唯一的硬通货！没有输入输出的日常，就是一具未经启动的死尸。" vertex="1">
          <mxGeometry height="25" width="900" x="560" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-19" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#880E4F;fontStyle=1;fillColor=#F8BBD0;" value="【实操检验标准】今天是否用正确的方法搜了资料？是否硬着头皮读了非虚构好书？是否写下了反思？" vertex="1">
          <mxGeometry height="30" width="920" x="550" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;溯源式硬核检索&lt;/b&gt;&lt;hr style=&quot;border-color:#555555;margin:5px 0&quot;&gt;&lt;b&gt;只用&lt;/b&gt;：Google/NCR&lt;br&gt;&lt;b&gt;必用&lt;/b&gt;：英文关键字、加减号、引号精确匹配&lt;br&gt;&lt;b&gt;戒除&lt;/b&gt;：“连不上网怎么办”的巨婴提问" vertex="1">
          <mxGeometry height="90" width="200" x="550" y="1085" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;啃读非虚构读物&lt;/b&gt;&lt;hr style=&quot;border-color:#555555;margin:5px 0&quot;&gt;&lt;b&gt;放弃&lt;/b&gt;：小说、标题党、碎片化网文&lt;br&gt;&lt;b&gt;直击&lt;/b&gt;：多版次高印数专著，先扫目录，建立预期，反复死磕，强行理解" vertex="1">
          <mxGeometry height="90" width="200" x="780" y="1085" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;通过“教与写”来学&lt;/b&gt;&lt;hr style=&quot;border-color:#555555;margin:5px 0&quot;&gt;&lt;b&gt;动作&lt;/b&gt;：把学到的概念用自己语言讲给别人/写文章。&lt;br&gt;&lt;b&gt;收益&lt;/b&gt;：逼迫大脑结构化，且分享成本为0，获益无上限" vertex="1">
          <mxGeometry height="90" width="200" x="1010" y="1085" as="geometry" />
        </mxCell>
        <mxCell id="UO7uAtX1WqEGF_7-64Dm-23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;直接切断无用耗损&lt;/b&gt;&lt;hr style=&quot;border-color:#555555;margin:5px 0&quot;&gt;&lt;b&gt;坚决&lt;/b&gt;：不争辩，遇傻逼直接拉黑&lt;br&gt;&lt;b&gt;坚决&lt;/b&gt;：群聊设为免打扰&lt;br&gt;&lt;b&gt;核心&lt;/b&gt;：把省下的生命时间用来打磨自己的手艺" vertex="1">
          <mxGeometry height="90" width="200" x="1240" y="1085" as="geometry" />
        </mxCell>
