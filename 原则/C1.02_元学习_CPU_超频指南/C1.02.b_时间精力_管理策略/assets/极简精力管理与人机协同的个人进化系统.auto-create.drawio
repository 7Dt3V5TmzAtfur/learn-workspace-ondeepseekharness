        <mxCell id="SLCEbYdilAT7MOBbuYth-70" parent="s1x-pVxz8RHmVTc7Oy0w-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1;fontColor=#E65100;align=center;verticalAlign=middle;spacing=8;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;⚠️ 风险二：FOMO 技术焦虑&lt;/b&gt;&lt;hr style=&quot;border-color: #FB8C00; margin: 5px 0;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 13px; line-height: 1.4;&quot;&gt;&lt;b&gt;对策：启用价值过滤网&lt;/b&gt;&lt;ul style=&quot;margin: 5px 0 0 0; padding-left: 20px;&quot;&gt;&lt;li&gt;不学不能解决当下&lt;b&gt;主线&lt;/b&gt;的技术&lt;/li&gt;&lt;li&gt;哪怕圈子再火，五年后呢？&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
