        <mxCell id="SLCEbYdilAT7MOBbuYth-61" parent="s1x-pVxz8RHmVTc7Oy0w-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00897B;strokeWidth=1;fontColor=#004D40;align=center;verticalAlign=middle;spacing=8;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;第4层：社会化输出&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;(里程碑展示)&lt;/span&gt;&lt;hr style=&quot;border-color: #00897B; margin: 5px 0;&quot;&gt;&lt;ul style=&quot;margin: 5px 0 0 0; padding-left: 20px; text-align: left; line-height: 1.4; font-size: 13px;&quot;&gt;&lt;li&gt;每年掌握一项硬技能&lt;/li&gt;&lt;li&gt;做主页宣传卖点/证书&lt;/li&gt;&lt;li&gt;转化为实体资产&lt;/li&gt;&lt;/ul&gt;" vertex="1">
