        <mxCell id="n2_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;捕捉关键动作&lt;/b&gt;&lt;hr style=&quot;border-color:#555555;margin:5px 0&quot;&gt;让大脑精准识别出&lt;br&gt;究竟该重复什么行为" vertex="1">
