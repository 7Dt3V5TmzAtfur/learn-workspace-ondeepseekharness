    <mxGraphModel dx="4065" dy="1676" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="465" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#555555;strokeWidth=1.5;fontColor=#330066;align=center;" value="&lt;b style=&quot;font-size:26px&quot;&gt;从补偿式安慰到行为强化：重塑你的自我奖励系统&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;核心要义：放弃“吃苦交易”的被动补偿思维，用精准的正向反馈为具体动作充能，让好习惯自动运转。&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1370" x="-30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="tag" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#555555;fontColor=#333333;fontStyle=1;align=center;" value="#行为强化 #反补偿机制 #习惯重塑" vertex="1">
          <mxGeometry height="30" width="220" x="-10" y="35" as="geometry" />
        </mxCell>
        <mxCell id="layer4_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F5FF;strokeColor=#555555;strokeWidth=1.5;" vertex="1">
          <mxGeometry height="220" width="960" x="140" y="100" as="geometry" />
        </mxCell>
        <mxCell id="layer4_lbl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F5FF;strokeColor=#555555;strokeWidth=1.5;fontColor=#001144;align=center;" value="&lt;b style=&quot;font-size:16px&quot;&gt;实践层&lt;br&gt;&lt;br&gt;场景重塑&lt;/b&gt;" vertex="1">
          <mxGeometry height="220" width="100" x="20" y="100" as="geometry" />
        </mxCell>
        <mxCell id="layer4_first_principle" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#001144;fontStyle=1;" value="【第一性原理】好的奖励机制本身就是源源不断的动力，让你不靠硬撑一步步重塑自我。" vertex="1">
          <mxGeometry height="25" width="900" x="170" y="105" as="geometry" />
        </mxCell>
        <mxCell id="layer4_bottom_logic" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#001144;fontStyle=1;fillColor=#E6EEFF;" value="【底层拷问】每次犒劳前停下自问：“这个奖励，是在强化我刚才的动作，还是在补偿我刚才受过的苦？”" vertex="1">
          <mxGeometry height="30" width="920" x="160" y="280" as="geometry" />
        </mxCell>
        <mxCell id="n4_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;【读书场景】&lt;/b&gt;&lt;hr style=&quot;border-color:#555555;margin:5px 0&quot;&gt;❌ 补偿：刷几小时短视频&lt;br&gt;✅ 奖励：不拿手机凭窗回味&lt;br&gt;&lt;font color=&#39;#555555&#39;&gt;(沉淀舒服的完成感)&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="260" x="180" y="160" as="geometry" />
        </mxCell>
        <mxCell id="n4_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;【早起场景】&lt;/b&gt;&lt;hr style=&quot;border-color:#555555;margin:5px 0&quot;&gt;❌ 补偿：周末睡懒觉到中午&lt;br&gt;✅ 奖励：一顿不慌不忙的早餐&lt;br&gt;&lt;font color=&#39;#555555&#39;&gt;(享受专属的悠闲时光)&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="260" x="480" y="160" as="geometry" />
        </mxCell>
        <mxCell id="n4_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;【健身场景】&lt;/b&gt;&lt;hr style=&quot;border-color:#555555;margin:5px 0&quot;&gt;❌ 补偿：一顿高热量大餐&lt;br&gt;✅ 奖励：慢洗热水澡/好喝蛋白饮&lt;br&gt;&lt;font color=&#39;#555555&#39;&gt;(体会身体被照顾的清爽)&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="260" x="780" y="160" as="geometry" />
        </mxCell>
        <mxCell id="layer3_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#555555;strokeWidth=1.5;" vertex="1">
          <mxGeometry height="220" width="960" x="140" y="340" as="geometry" />
        </mxCell>
        <mxCell id="layer3_lbl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#555555;strokeWidth=1.5;fontColor=#064E3B;align=center;" value="&lt;b style=&quot;font-size:16px&quot;&gt;规则层&lt;br&gt;&lt;br&gt;双重校验&lt;/b&gt;" vertex="1">
          <mxGeometry height="220" width="100" x="20" y="340" as="geometry" />
        </mxCell>
        <mxCell id="layer3_first_principle" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#064E3B;fontStyle=1;" value="【第一性原理】有效的奖励必须让大脑清晰识别目标动作，并彻底消除神经指令层面的冲突。" vertex="1">
          <mxGeometry height="25" width="900" x="170" y="345" as="geometry" />
        </mxCell>
        <mxCell id="layer3_bottom_logic" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#064E3B;fontStyle=1;fillColor=#DCFCE7;" value="【底层机制】奖励同时满足“精确识别”与“方向同频”两个条件，否则你的犒劳就是在亲手拆台。" vertex="1">
          <mxGeometry height="30" width="920" x="160" y="520" as="geometry" />
        </mxCell>
        <mxCell id="group3_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#555555;strokeWidth=1;dashed=1;verticalAlign=top;spacingTop=5;fontStyle=1;" value="条件一：精准度校验" vertex="1">
          <mxGeometry height="120" width="410" x="180" y="385" as="geometry" />
        </mxCell>
        <mxCell id="n3_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;精准标记动作本身&lt;/b&gt;&lt;hr style=&quot;border-color:#555555;margin:5px 0&quot;&gt;奖励具体动作而非模糊的最终结果&lt;br&gt;大脑只记动作，无法挂钩遥远目标&lt;br&gt;(❌奖励瘦十斤 ✅奖励今天早睡)" vertex="1">
          <mxGeometry height="80" width="370" x="200" y="415" as="geometry" />
        </mxCell>
        <mxCell id="group3_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#555555;strokeWidth=1;dashed=1;verticalAlign=top;spacingTop=5;fontStyle=1;" value="条件二：方向性校验" vertex="1">
          <mxGeometry height="120" width="410" x="650" y="385" as="geometry" />
        </mxCell>
        <mxCell id="n3_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;shadow=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;避免长期动机混乱&lt;/b&gt;&lt;hr style=&quot;border-color:#555555;margin:5px 0&quot;&gt;奖励本身绝不能与想要的方向矛盾&lt;br&gt;否则长期会倾向于更简单刺激的选项&lt;br&gt;(❌用暴饮暴食奖励健康生活尝试)" vertex="1">
          <mxGeometry height="80" width="370" x="670" y="415" as="geometry" />
