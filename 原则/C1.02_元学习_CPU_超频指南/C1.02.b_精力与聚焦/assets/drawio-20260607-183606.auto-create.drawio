        <mxCell id="layer2_lbl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#555555;strokeWidth=1.5;fontColor=#553300;align=center;" value="&lt;b style=&quot;font-size:16px&quot;&gt;原理层&lt;br&gt;&lt;br&gt;核心作用&lt;/b&gt;" vertex="1">
